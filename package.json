{
  "name": "universal-ai-development-toolkit",
  "private": true,
  "version": "6.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-toolkit.mjs",
    "21st:search": "node scripts/21st.mjs search",
    "21st:add": "node scripts/21st.mjs add",
    "21st:login": "npx -y @21st-dev/cli login",
    "shadcn:add": "npx -y shadcn@latest add",
    "check": "npm run verify && npm run cinematic:audit && npm run typecheck && npm run build",
    "design:install": "npx -y ui-ux-pro-max-cli init --ai universal",
    "design:install:gemini": "npx -y ui-ux-pro-max-cli init --ai gemini",
    "21st:skills": "npx -y @21st-dev/cli skills install",
    "catalog": "node scripts/list-components.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "cinematic:audit": "node scripts/audit-cinematic.mjs",
    "site:list": "node scripts/new-site.mjs --list",
    "site:new": "node scripts/new-site.mjs",
    "studio:audit": "node scripts/audit-studio.mjs",
    "check:studio": "npm run verify && npm run cinematic:audit && npm run studio:audit && npm run typecheck && npm run build",
    "site:brief": "node scripts/brief-router.mjs",
    "assets:audit": "node scripts/audit-assets.mjs",
    "premium:audit": "node scripts/audit-premium.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:premium": "npm run check:offline && npm run typecheck && npm run build",
    "site:auto": "node scripts/create-site-from-brief.mjs",
    "audit:recipes": "node scripts/audit-recipes.mjs",
    "site:director": "node scripts/creative-director.mjs",
    "site:doctor": "node scripts/site-doctor.mjs",
    "audit:combinations": "node scripts/audit-combinations.mjs",
    "audit:imports": "node scripts/audit-imports.mjs",
    "check:offline": "npm run verify && npm run cinematic:audit && npm run studio:audit && npm run premium:audit && npm run assets:audit && npm run audit:recipes && npm run audit:combinations && npm run audit:imports && npm run site:doctor && npm test && npm run motion:audit && npm run motion:test",
    "visual:audit": "node scripts/audit-visual-assets.mjs",
    "visual:briefs": "node scripts/generate-visual-briefs.mjs",
    "check:visual": "npm run visual:audit && npm run typecheck && npm run build",
    "media:plan": "node scripts/media/plan.mjs",
    "media:generate": "node scripts/media/generate.mjs",
    "media:ingest": "node scripts/media/ingest.mjs",
    "media:audit": "node scripts/media/audit.mjs",
    "media:promote": "node scripts/media/promote.mjs",
    "media:test": "node --test tests/media-hybrid.test.mjs",
    "media:reset": "node scripts/media/reset.mjs",
    "motion:audit": "node scripts/audit-motion.mjs",
    "motion:test": "node --test tests/motion-system.test.mjs",
    "check:motion": "npm run motion:audit && npm run motion:test && npm run typecheck && npm run build",
    "motion:plan": "node scripts/plan-motion.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "lucide-react": "^0.500.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.2.0",
    "@react-three/postprocessing": "^3.0.0",
    "postprocessing": "^6.38.0",
    "@gsap/react": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@types/node": "^22.0.0"
  },
  "description": "Universal Cinematic Studio v6.4 \u2014 configurable original cinematic scroll and motion components with hybrid photoreal media gates"
}
